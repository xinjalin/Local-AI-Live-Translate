# Downloaded on first run by tools/setup.ps1 (see tools/dependencies.json)
/runtime/
/models/
/.setup-tmp/

# Developer Python environment
/server/.venv/
__pycache__/
*.py[cod]

# Build output (published on the GitHub Releases page instead)
/dist/

# Personal data: saved subtitle transcripts, and your own prompt templates
/transcripts/
/templates/*.json
!/templates/_example.json
!/templates/generic.json
!/templates/hy-mt.json
!/templates/milmmt.json

# Secrets and local settings - never commit these
.env
.env.*
*.key
*.pem

# Logs, editors, OS files
*.log
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
